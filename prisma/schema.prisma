// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      UserRole @default(PARENT)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SchoolClass {
  id        String    @id @default(cuid())
  name      String    @unique
  subjects  Subject[]
  sections  Section[]
  students  Student[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Section {
  id        String      @id @default(cuid())
  name      String      // A, B, C
  classId   String
  class     SchoolClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  students  Student[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@unique([classId, name])
}

model Subject {
  id          String      @id @default(cuid())
  name        String      
  code        String?     
  classId     String
  class       SchoolClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@unique([classId, name]) 
}

model Student {
  id            String        @id @default(cuid())
  studentId     String        @unique // e.g., "STU-2026-001"
  name          String
  dateOfBirth   DateTime?
  gender        Gender?
  photo         String?       // ছবির URL
  classId       String
  class         SchoolClass   @relation(fields: [classId], references: [id], onDelete: Restrict)
  sectionId     String
  section       Section       @relation(fields: [sectionId], references: [id], onDelete: Restrict)
  roll          String
  admissionDate DateTime      @default(now())
  status        StudentStatus @default(ACTIVE)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  @@unique([classId, sectionId, roll]) 
}



enum UserRole {
  ADMIN
  TEACHER
  PARENT
}

enum Gender {
  MALE
  FEMALE
  OTHER
}
enum StudentStatus {
  ACTIVE
  INACTIVE
  TRANSFERRED
}

