generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      UserRole @default(PARENT)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SchoolClass {
  id                 String              @id @default(cuid())
  name               String              @unique
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  routines           ClassRoutine[]
  classSubjects      ClassSubject[]
  sections           Section[]
  students           Student[]
  teacherAssignments TeacherAssignment[]
}

model AcademicGroup {
  id            String         @id @default(cuid())
  name          String         @unique
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  classSubjects ClassSubject[]
  students      Student[]
}

model Section {
  id                 String              @id @default(cuid())
  name               String
  classId            String
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  routines           ClassRoutine[]
  class              SchoolClass         @relation(fields: [classId], references: [id], onDelete: Cascade)
  students           Student[]
  teacherAssignments TeacherAssignment[]

  @@unique([classId, name])
}

model Subject {
  id                 String              @id @default(cuid())
  name               String              @unique
  code               String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  routines           ClassRoutine[]
  classSubjects      ClassSubject[]
  results            Result[]
  teacherAssignments TeacherAssignment[]
}

model ClassSubject {
  id           String         @id @default(cuid())
  classId      String
  groupId      String?
  subjectId    String
  isCompulsory Boolean        @default(true)
  isOptional   Boolean        @default(false)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  class        SchoolClass    @relation(fields: [classId], references: [id], onDelete: Cascade)
  group        AcademicGroup? @relation(fields: [groupId], references: [id], onDelete: Cascade)
  subject      Subject        @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@index([classId])
  @@index([groupId])
  @@index([subjectId])
}

model Student {
  id            String          @id @default(cuid())
  studentId     String          @unique
  name          String
  dateOfBirth   DateTime?
  gender        Gender?
  photo         String?
  classId       String
  sectionId     String
  groupId       String?
  roll          String
  admissionDate DateTime        @default(now())
  status        StudentStatus   @default(ACTIVE)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  parents       ParentStudent[]
  results       Result[]
  class         SchoolClass     @relation(fields: [classId], references: [id])
  group         AcademicGroup?  @relation(fields: [groupId], references: [id], onDelete: Restrict)
  section       Section         @relation(fields: [sectionId], references: [id])

  @@unique([classId, sectionId, roll])
}

model Parent {
  id        String          @id @default(cuid())
  name      String
  phone     String
  email     String?
  address   String?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  students  ParentStudent[]
}

model ParentStudent {
  id        String         @id @default(cuid())
  parentId  String
  studentId String
  relation  ParentRelation
  isPrimary Boolean        @default(false)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  parent    Parent         @relation(fields: [parentId], references: [id], onDelete: Cascade)
  student   Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([parentId, studentId])
}

model Teacher {
  id          String              @id @default(cuid())
  teacherId   String              @unique
  name        String
  email       String?             @unique
  phone       String
  designation String
  department  String?
  joiningDate DateTime?           @default(now())
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  routines    ClassRoutine[]
  assignments TeacherAssignment[]
}

model TeacherAssignment {
  id             String      @id @default(cuid())
  teacherId      String
  classId        String
  sectionId      String
  subjectId      String
  isClassTeacher Boolean     @default(false)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  class          SchoolClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  section        Section     @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  subject        Subject     @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher        Teacher     @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([classId, sectionId, subjectId])
}

model ClassRoutine {
  id         String      @id @default(cuid())
  day        DayOfWeek
  startTime  String
  endTime    String
  roomNumber String?
  classId    String
  sectionId  String
  subjectId  String
  teacherId  String
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  class      SchoolClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  section    Section     @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  subject    Subject     @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher    Teacher     @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([day, classId, sectionId])
  @@index([day, teacherId])
}

model Exam {
  id          String     @id @default(cuid())
  name        String
  year        Int
  status      ResultStatus @default(DRAFT)
  resultPublishedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  results     Result[]

  @@unique([name, year])
}

model Result {
  id        String   @id @default(cuid())
  studentId String
  examId    String
  subjectId String
  marks     Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  fullMarks Float
  exam      Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject   Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([studentId, examId, subjectId])
  @@index([studentId])
  @@index([examId])
  @@index([subjectId])
}

enum UserRole {
  ADMIN
  TEACHER
  PARENT
}

enum DayOfWeek {
  SATURDAY
  SUNDAY
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum StudentStatus {
  ACTIVE
  INACTIVE
  TRANSFERRED
}

enum ParentRelation {
  FATHER
  MOTHER
  GUARDIAN
  OTHER
}

enum ResultStatus {
  DRAFT
  PUBLISHED
}
