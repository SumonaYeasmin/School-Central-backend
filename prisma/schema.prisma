generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ===============================
// USER
// ===============================
model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      UserRole @default(PARENT)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ===============================
// SCHOOL CLASS
// ===============================
model SchoolClass {
  id                 String              @id @default(cuid())
  name               String              @unique
  sections           Section[]
  classSubjects      ClassSubject[]
  students           Student[]
  teacherAssignments TeacherAssignment[]
  routines           ClassRoutine[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
}

// ===============================
// ACADEMIC GROUP
// Science / Humanities / Business Studies
// ===============================
model AcademicGroup {
  id            String         @id @default(cuid())
  name          String         @unique
  classSubjects ClassSubject[]
  students      Student[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

// ===============================
// SECTION
// A / B / C
// ===============================
model Section {
  id                 String              @id @default(cuid())
  name               String
  classId            String
  class              SchoolClass         @relation(fields: [classId], references: [id], onDelete: Cascade)
  students           Student[]
  teacherAssignments TeacherAssignment[]
  routines           ClassRoutine[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@unique([classId, name])
}

// ===============================
// SUBJECT
// ===============================
model Subject {
  id                 String              @id @default(cuid())
  name               String              @unique
  code               String?
  classSubjects      ClassSubject[]
  teacherAssignments TeacherAssignment[]
  routines           ClassRoutine[]
  results            Result[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
}

// ===============================
// CLASS SUBJECT
// কোন Class-এ কোন Subject থাকবে
// Group-specific Subject হলে groupId থাকবে
// Common Subject হলে groupId = null
// ===============================
model ClassSubject {
  id           String         @id @default(cuid())
  classId      String
  groupId      String?
  subjectId    String
  isCompulsory Boolean        @default(true)
  isOptional   Boolean        @default(false)
  class        SchoolClass    @relation(fields: [classId], references: [id], onDelete: Cascade)
  group        AcademicGroup? @relation(fields: [groupId], references: [id], onDelete: Cascade)
  subject      Subject        @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([classId])
  @@index([groupId])
  @@index([subjectId])
}

// ===============================
// STUDENT
// ===============================
model Student {
  id            String          @id @default(cuid())
  studentId     String          @unique
  name          String
  dateOfBirth   DateTime?
  gender        Gender?
  photo         String?
  classId       String
  sectionId     String
  groupId       String?
  roll          String
  admissionDate DateTime        @default(now())
  status        StudentStatus   @default(ACTIVE)
  class         SchoolClass     @relation(fields: [classId], references: [id], onDelete: Restrict)
  section       Section         @relation(fields: [sectionId], references: [id], onDelete: Restrict)
  group         AcademicGroup?  @relation(fields: [groupId], references: [id], onDelete: Restrict)
  parents       ParentStudent[]
  results       Result[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@unique([classId, sectionId, roll])
}

// ===============================
// PARENT
// ===============================
model Parent {
  id        String          @id @default(cuid())
  name      String
  phone     String
  email     String?
  address   String?
  students  ParentStudent[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
}

// ===============================
// PARENT ↔ STUDENT
// Many-to-Many Relation
// ===============================
model ParentStudent {
  id        String         @id @default(cuid())
  parentId  String
  studentId String
  relation  ParentRelation
  isPrimary Boolean        @default(false)
  parent    Parent         @relation(fields: [parentId], references: [id], onDelete: Cascade)
  student   Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([parentId, studentId])
}

// ===============================
// TEACHER
// ===============================
model Teacher {
  id          String              @id @default(cuid())
  teacherId   String              @unique
  name        String
  email       String?             @unique
  phone       String
  designation String
  department  String?
  joiningDate DateTime?           @default(now())
  assignments TeacherAssignment[]
  routines    ClassRoutine[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
}

// ===============================
// TEACHER ASSIGNMENT
// কোন Teacher কোন Class / Section / Subject পড়াবে
// ===============================
model TeacherAssignment {
  id             String      @id @default(cuid())
  teacherId      String
  classId        String
  sectionId      String
  subjectId      String
  isClassTeacher Boolean     @default(false)
  teacher        Teacher     @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  class          SchoolClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  section        Section     @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  subject        Subject     @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@unique([classId, sectionId, subjectId])
}

// ===============================
// CLASS ROUTINE
// ===============================
model ClassRoutine {
  id         String      @id @default(cuid())
  day        DayOfWeek
  startTime  String
  endTime    String
  roomNumber String?
  classId    String
  sectionId  String
  subjectId  String
  teacherId  String
  class      SchoolClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  section    Section     @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  subject    Subject     @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher    Teacher     @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@index([day, classId, sectionId])
  @@index([day, teacherId])
}

// ===============================
// EXAM
// ===============================
model Exam {
  id          String     @id @default(cuid())
  name        String
  year        Int
  status      ExamStatus @default(DRAFT)
  publishedAt DateTime?

  results Result[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name, year])
}

// ===============================
// RESULT
// ===============================
model Result {
  id        String @id @default(cuid())

  studentId String
  examId    String
  subjectId String

  marks     Float

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  exam    Exam    @relation(fields: [examId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, examId, subjectId])
  @@index([studentId])
  @@index([examId])
  @@index([subjectId])
}

// ===============================
// ENUMS
// ===============================
enum UserRole {
  ADMIN
  TEACHER
  PARENT
}

enum ExamStatus {
  DRAFT
  PUBLISHED
}

enum DayOfWeek {
  SATURDAY
  SUNDAY
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum StudentStatus {
  ACTIVE
  INACTIVE
  TRANSFERRED
}

enum ParentRelation {
  FATHER
  MOTHER
  GUARDIAN
  OTHER
}
